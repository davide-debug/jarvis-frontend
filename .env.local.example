# Copia in .env.local
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=ey...
NEXT_PUBLIC_BACKEND_URL=

# --- Sincronizzazione chiamate ---
# Service role di Supabase (SOLO lato server, usato dalle API route).
SUPABASE_SERVICE_ROLE_KEY=ey...

# Service account Google con accesso in lettura alla cartella dei backup.
# Incolla il JSON delle credenziali (raw oppure codificato in base64).
GOOGLE_SERVICE_ACCOUNT_JSON=

# (Opzionale) Id della cartella di Drive che contiene i file calls-*.xml.
GDRIVE_CALLS_FOLDER_ID=

# (Opzionale) Se impostato, l'endpoint /api/calls/sync richiede questo segreto
# nell'header x-sync-secret (consigliato in produzione + per il cron).
CALLS_SYNC_SECRET=
